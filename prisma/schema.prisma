generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  queued
  applied
  interview
  rejected
  offer
}

enum AtsType {
  manual
  greenhouse
  lever
}

enum JobSourceType {
  GREENHOUSE
  LEVER
  CAREERS_PAGE_JSONLD
}

enum IngestStatus {
  SUCCESS
  FAIL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  githubUrl    String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resumes      Resume[]
  experiences  ExperienceItem[]
  jobSources   JobSource[]
  dailyQueues  DailyQueue[]
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  filePath      String
  extractedText String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model ExperienceItem {
  id          String   @id @default(cuid())
  userId      String
  company     String
  title       String
  startDate   String?
  endDate     String?
  bullets     Json
  skillsTags  String[]
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model TargetProfile {
  id              String   @id @default(cuid())
  name            String
  locations       String[]
  remoteAllowed   Boolean  @default(true)
  roleTitles      String[]
  includeKeywords String[]
  excludeKeywords String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scores          JobScore[]
  dailyQueues     DailyQueue[]
}

model Company {
  id            String   @id @default(cuid())
  name          String   @unique
  atsType       AtsType
  boardUrl      String?
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobs          JobPosting[]
}

model JobPosting {
  id          String       @id @default(cuid())
  source      String
  url         String?
  title       String
  location    String?
  remote      Boolean      @default(false)
  description String
  postedAt    DateTime?
  ingestedAt  DateTime     @default(now())
  hash        String       @unique
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  scores      JobScore[]
  applications Application[]
  packet      Packet?
  queueItems  DailyQueueItem[]
}

model JobScore {
  id              String       @id @default(cuid())
  jobId           String
  targetProfileId String
  scoreNumeric    Int
  reasonsJson     Json
  createdAt       DateTime     @default(now())
  job             JobPosting   @relation(fields: [jobId], references: [id])
  targetProfile   TargetProfile @relation(fields: [targetProfileId], references: [id])

  @@unique([jobId, targetProfileId])
}

model Packet {
  id               String     @id @default(cuid())
  jobId            String     @unique
  resumeVariantText String
  coverLetterText  String?
  fieldPackJson    Json
  createdAt        DateTime   @default(now())
  job              JobPosting @relation(fields: [jobId], references: [id])
  applications     Application[]
}

model Application {
  id         String            @id @default(cuid())
  jobId      String
  status     ApplicationStatus @default(queued)
  appliedAt  DateTime?
  notes      String?
  followUpAt DateTime?
  packetId   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  job        JobPosting        @relation(fields: [jobId], references: [id])
  packet     Packet?           @relation(fields: [packetId], references: [id])
}

model JobSource {
  id          String        @id @default(cuid())
  userId      String
  name        String
  type        JobSourceType
  urlOrHandle String
  isEnabled   Boolean       @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  runs        IngestRun[]
}

model IngestRun {
  id          String       @id @default(cuid())
  jobSourceId String
  startedAt   DateTime
  finishedAt  DateTime?
  status      IngestStatus
  statsJson   Json
  errorText   String?
  jobSource   JobSource    @relation(fields: [jobSourceId], references: [id])
}

model DailyQueue {
  id              String        @id @default(cuid())
  userId          String
  date            String
  targetProfileId String
  maxItems        Int           @default(8)
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id])
  targetProfile   TargetProfile @relation(fields: [targetProfileId], references: [id])
  items           DailyQueueItem[]

  @@unique([userId, date, targetProfileId])
}

model DailyQueueItem {
  id           String     @id @default(cuid())
  dailyQueueId String
  jobId        String
  rank         Int
  score        Int
  createdAt    DateTime   @default(now())
  dailyQueue   DailyQueue @relation(fields: [dailyQueueId], references: [id], onDelete: Cascade)
  job          JobPosting @relation(fields: [jobId], references: [id])

  @@unique([dailyQueueId, jobId])
}
